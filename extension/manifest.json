{
  "manifest_version": 3,
  "name": "FastDrop 下载助手",
  "version": "1.0.0",
  "description": "右键或点击下载链接，一键交给 FastDrop 游戏下载盒子（无需复制链接）",
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}